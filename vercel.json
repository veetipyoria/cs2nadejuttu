{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "vite"
    },
    "api": {
      "root": "server/",
      "framework": "hono",
      "entrypoint": "src/app.ts",
      "functions": {
        "src/app.ts": {
          "includeFiles": "schema.sql"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
