{
  "name": "nadedeck-server",
  "version": "1.0.0",
  "description": "NadeDeck API",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
