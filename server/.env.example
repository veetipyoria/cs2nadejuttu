# Copy to .env and adjust. All values are optional.
# Set to production when deploying (enables Secure cookies)
NODE_ENV=development
PORT=3001
# SQLite file, relative to the server folder
DATABASE_PATH=data/nadedeck.db
# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173
# Built frontend served by the API in production (set empty to disable)
STATIC_DIR=../my-react-app/dist
# Creates (or promotes) an admin account on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
