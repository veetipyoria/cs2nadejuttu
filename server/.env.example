# Copy to .env and adjust. All values are optional. Never commit .env.
# Set to production when deploying (enables Secure cookies)
NODE_ENV=development
PORT=3001

# --- Database ---
# Turso: set both to use the hosted database. Leave empty to use a local SQLite file instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Only for `npm run db:copy-prod-to-dev` (copies production data into the test database).
# Production is only read. Never commit real values.
PROD_TURSO_DATABASE_URL=
PROD_TURSO_AUTH_TOKEN=
DEV_TURSO_DATABASE_URL=
DEV_TURSO_AUTH_TOKEN=
# Local SQLite file (used only when TURSO_DATABASE_URL is empty), relative to the server folder
DATABASE_PATH=data/nadedeck.db

# Set to true only behind a proxy that sets x-real-ip / x-forwarded-for (e.g. Cloudflare).
# Not needed on Vercel (detected automatically).
TRUST_PROXY=false

# Comma-separated browser origins allowed to call the API directly
CORS_ORIGINS=http://localhost:5173
# Built frontend served by the API in production (set empty to disable)
STATIC_DIR=../dist
# Creates (or promotes) an admin account on startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
